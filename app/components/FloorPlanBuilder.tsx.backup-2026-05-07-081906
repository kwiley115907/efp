                  <option key={wall.id} value={wall.id}>
                    {wall.label || `Wall ${wall.id}`}
                  </option>
                ))}
              </select>
            </label>

            <label className="text-sm">
              Offset From Wall Start
              <input className="mt-1 w-full rounded-lg border p-2" value={doorOffsetInput} onChange={(e) => setDoorOffsetInput(e.target.value)} />
            </label>

            <label className="text-sm">
              Width
              <input className="mt-1 w-full rounded-lg border p-2" value={doorWidthInput} onChange={(e) => setDoorWidthInput(e.target.value)} />
            </label>

            <label className="text-sm">
              Type
              <select className="mt-1 w-full rounded-lg border p-2" value={doorKind} onChange={(e) => setDoorKind(e.target.value as "door" | "opening")}>
                <option value="door">Door</option>
                <option value="opening">Opening</option>
