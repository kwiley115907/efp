            Add Door / Opening
          </button>

          <div className="max-h-40 space-y-2 overflow-auto">
            {doors.map((item) => (
              <div key={item.id} className="rounded-xl border p-3 text-sm">
                <div className="font-semibold">{item.label || `${item.kind} ${item.id}`}</div>
                <div>Wall ID: {item.wallId}</div>
                <div>Offset: {formatFeet(item.offset)}</div>
                <div>Width: {formatFeet(item.width)}</div>
                <button className="mt-2 rounded-lg bg-red-600 px-3 py-1 text-white" onClick={() => deleteDoor(item.id)}>
                  Delete
                </button>
              </div>
            ))}
          </div>
        </section>

        <section className="space-y-3 border-t pt-4">
          <h3 className="text-lg font-semibold">4) Windows</h3>
          <div className="grid grid-cols-2 gap-3">
            <label className="col-span-2 text-sm">
              Wall
              <select className="mt-1 w-full rounded-lg border p-2" value={windowWallId} onChange={(e) => setWindowWallId(Number(e.target.value))}>
                <option value={0}>Select a wall</option>
                {walls.map((wall) => (
                  <option key={wall.id} value={wall.id}>
                    {wall.label || `Wall ${wall.id}`}
                  </option>
                ))}
              </select>
            </label>

            <label className="text-sm">
              Offset From Wall Start
              <input className="mt-1 w-full rounded-lg border p-2" value={windowOffsetInput} onChange={(e) => setWindowOffsetInput(e.target.value)} />
            </label>

            <label className="text-sm">
              Width
              <input className="mt-1 w-full rounded-lg border p-2" value={windowWidthInput} onChange={(e) => setWindowWidthInput(e.target.value)} />
            </label>

            <label className="col-span-2 text-sm">
              Label
              <input className="mt-1 w-full rounded-lg border p-2" value={windowLabelInput} onChange={(e) => setWindowLabelInput(e.target.value)} placeholder="Window A" />
            </label>
          </div>

          <button className="w-full rounded-xl bg-sky-600 px-4 py-2 text-white" onClick={addWindow}>
            Add Window
          </button>

          <div className="max-h-40 space-y-2 overflow-auto">
            {windows.map((item) => (
              <div key={item.id} className="rounded-xl border p-3 text-sm">
                <div className="font-semibold">{item.label || `Window ${item.id}`}</div>
                <div>Wall ID: {item.wallId}</div>
                <div>Offset: {formatFeet(item.offset)}</div>
                <div>Width: {formatFeet(item.width)}</div>
                <button className="mt-2 rounded-lg bg-red-600 px-3 py-1 text-white" onClick={() => deleteWindow(item.id)}>
                  Delete
                </button>
              </div>
            ))}
          </div>
        </section>

        <section className="space-y-3 border-t pt-4">
          <h3 className="text-lg font-semibold">5) Stairs</h3>
          <div className="grid grid-cols-2 gap-3">
            <label className="text-sm">
              X
              <input className="mt-1 w-full rounded-lg border p-2" value={stairXInput} onChange={(e) => setStairXInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Y
              <input className="mt-1 w-full rounded-lg border p-2" value={stairYInput} onChange={(e) => setStairYInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Width
              <input className="mt-1 w-full rounded-lg border p-2" value={stairWidthInput} onChange={(e) => setStairWidthInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Height
              <input className="mt-1 w-full rounded-lg border p-2" value={stairHeightInput} onChange={(e) => setStairHeightInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Steps
              <input className="mt-1 w-full rounded-lg border p-2" value={stairStepsInput} onChange={(e) => setStairStepsInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Direction
              <select className="mt-1 w-full rounded-lg border p-2" value={stairDirection} onChange={(e) => setStairDirection(e.target.value as "up" | "down")}>
                <option value="up">Up</option>
                <option value="down">Down</option>
              </select>
            </label>
            <label className="col-span-2 text-sm">
              Label
              <input className="mt-1 w-full rounded-lg border p-2" value={stairLabelInput} onChange={(e) => setStairLabelInput(e.target.value)} />
            </label>
          </div>

          <button className="w-full rounded-xl bg-slate-700 px-4 py-2 text-white" onClick={addStairs}>
            Add Stairs
          </button>

          <div className="max-h-40 space-y-2 overflow-auto">
            {stairs.map((stair) => (
              <div key={stair.id} className="rounded-xl border p-3 text-sm">
                <div className="font-semibold">{stair.label || `Stair ${stair.id}`}</div>
                <div>Position: {formatFeet(stair.x)}, {formatFeet(stair.y)}</div>
                <div>Size: {formatFeet(stair.width)} × {formatFeet(stair.height)}</div>
                <button className="mt-2 rounded-lg bg-red-600 px-3 py-1 text-white" onClick={() => deleteStair(stair.id)}>
                  Delete
                </button>
              </div>
            ))}
          </div>
        </section>

        <section className="space-y-3 border-t pt-4">
          <h3 className="text-lg font-semibold">6) Room Labels</h3>
          <div className="grid grid-cols-2 gap-3">
            <label className="text-sm">
              X
              <input className="mt-1 w-full rounded-lg border p-2" value={roomLabelXInput} onChange={(e) => setRoomLabelXInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Y
              <input className="mt-1 w-full rounded-lg border p-2" value={roomLabelYInput} onChange={(e) => setRoomLabelYInput(e.target.value)} />
            </label>
            <label className="col-span-2 text-sm">
              Label Text
              <input className="mt-1 w-full rounded-lg border p-2" value={roomLabelTextInput} onChange={(e) => setRoomLabelTextInput(e.target.value)} />
            </label>
          </div>

          <button className="w-full rounded-xl bg-violet-600 px-4 py-2 text-white" onClick={addRoomLabel}>
            Add Room Label
          </button>

          <div className="max-h-40 space-y-2 overflow-auto">
            {roomLabels.map((label) => (
              <div key={label.id} className="rounded-xl border p-3 text-sm">
                <div className="font-semibold">{label.text}</div>
                <div>Position: {formatFeet(label.x)}, {formatFeet(label.y)}</div>
                <button className="mt-2 rounded-lg bg-red-600 px-3 py-1 text-white" onClick={() => deleteRoomLabel(label.id)}>
                  Delete
                </button>
              </div>
            ))}
          </div>
        </section>

        <section className="space-y-3 border-t pt-4">
          <h3 className="text-lg font-semibold">7) Manual Exit Paths</h3>
          <div className="grid grid-cols-1 gap-3">
            <label className="text-sm">
              Path Points (x,y; x,y; x,y)
              <textarea className="mt-1 min-h-[100px] w-full rounded-lg border p-2" value={exitPathPointsInput} onChange={(e) => setExitPathPointsInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Label
              <input className="mt-1 w-full rounded-lg border p-2" value={exitPathLabelInput} onChange={(e) => setExitPathLabelInput(e.target.value)} />
            </label>
          </div>

          <button className="w-full rounded-xl bg-green-700 px-4 py-2 text-white" onClick={addExitPath}>
            Add Manual Exit Path
          </button>

          <div className="max-h-40 space-y-2 overflow-auto">
            {exitPaths.map((path) => (
              <div key={path.id} className="rounded-xl border p-3 text-sm">
                <div className="font-semibold">{path.label || `Path ${path.id}`}</div>
                <div>Points: {path.points.length}</div>
                <button className="mt-2 rounded-lg bg-red-600 px-3 py-1 text-white" onClick={() => deleteExitPath(path.id)}>
                  Delete
                </button>
              </div>
            ))}
          </div>
        </section>

        <section className="space-y-3 border-t pt-4">
          <h3 className="text-lg font-semibold">8) Fire Extinguishers</h3>
          <div className="grid grid-cols-2 gap-3">
            <label className="text-sm">
              X
              <input className="mt-1 w-full rounded-lg border p-2" value={fireXInput} onChange={(e) => setFireXInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Y
              <input className="mt-1 w-full rounded-lg border p-2" value={fireYInput} onChange={(e) => setFireYInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Icon Size
              <input className="mt-1 w-full rounded-lg border p-2" value={fireSizeInput} onChange={(e) => setFireSizeInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Label
              <input className="mt-1 w-full rounded-lg border p-2" value={fireLabelInput} onChange={(e) => setFireLabelInput(e.target.value)} />
            </label>
          </div>

          <button className="w-full rounded-xl bg-red-700 px-4 py-2 text-white" onClick={addFireExtinguisher}>
            Add Fire Extinguisher
          </button>

          <div className="max-h-40 space-y-2 overflow-auto">
            {fireExtinguishers.map((item) => (
              <div key={item.id} className="rounded-xl border p-3 text-sm">
                <div className="font-semibold">{item.label || `FE ${item.id}`}</div>
                <div>Position: {formatFeet(item.x)}, {formatFeet(item.y)}</div>
                <button className="mt-2 rounded-lg bg-red-600 px-3 py-1 text-white" onClick={() => deleteFireExtinguisher(item.id)}>
                  Delete
                </button>
              </div>
            ))}
          </div>
        </section>

        <section className="space-y-3 border-t pt-4">
          <h3 className="text-lg font-semibold">9) Logo & Title Block</h3>

          <label className="text-sm">
            Upload Logo
            <input type="file" accept="image/*" className="mt-1 block w-full rounded-lg border p-2" onChange={handleLogoUpload} />
          </label>

          <div className="grid grid-cols-2 gap-3">
            <label className="text-sm">
              Logo Placement
              <select className="mt-1 w-full rounded-lg border p-2" value={logoPlacement} onChange={(e) => setLogoPlacement(e.target.value as LogoPlacement)}>
                <option value="top-left">Top Left</option>
                <option value="top-center">Top Center</option>
                <option value="top-right">Top Right</option>
                <option value="bottom-left">Bottom Left</option>
                <option value="bottom-center">Bottom Center</option>
                <option value="bottom-right">Bottom Right</option>
              </select>
            </label>

            <label className="text-sm">
              Logo Size
              <input className="mt-1 w-full rounded-lg border p-2" value={logoSizeInput} onChange={(e) => setLogoSizeInput(e.target.value)} />
            </label>

            <label className="col-span-2 text-sm">
              Logo Padding
              <input className="mt-1 w-full rounded-lg border p-2" value={logoPaddingInput} onChange={(e) => setLogoPaddingInput(e.target.value)} />
            </label>
          </div>

          <div className="grid grid-cols-1 gap-3">
            <label className="text-sm">
              Project Title
              <input className="mt-1 w-full rounded-lg border p-2" value={titleBlock.projectTitle} onChange={(e) => setTitleBlock((prev) => ({ ...prev, projectTitle: e.target.value }))} />
            </label>

            <label className="text-sm">
              Building Name
              <input className="mt-1 w-full rounded-lg border p-2" value={titleBlock.buildingName} onChange={(e) => setTitleBlock((prev) => ({ ...prev, buildingName: e.target.value }))} />
            </label>

            <label className="text-sm">
              Floor Name
              <input className="mt-1 w-full rounded-lg border p-2" value={titleBlock.floorName} onChange={(e) => setTitleBlock((prev) => ({ ...prev, floorName: e.target.value }))} />
            </label>

            <label className="text-sm">
              Drawn By
              <input className="mt-1 w-full rounded-lg border p-2" value={titleBlock.drawnBy} onChange={(e) => setTitleBlock((prev) => ({ ...prev, drawnBy: e.target.value }))} />
            </label>

            <label className="text-sm">
              Date
              <input className="mt-1 w-full rounded-lg border p-2" value={titleBlock.date} onChange={(e) => setTitleBlock((prev) => ({ ...prev, date: e.target.value }))} />
            </label>

            <label className="text-sm">
              Revision
              <input className="mt-1 w-full rounded-lg border p-2" value={titleBlock.revision} onChange={(e) => setTitleBlock((prev) => ({ ...prev, revision: e.target.value }))} />
            </label>
          </div>
        </section>

        <section className="space-y-3 border-t pt-4">
          <h3 className="text-lg font-semibold">10) Smart Evacuation Routing</h3>

          <div className="grid grid-cols-2 gap-3">
            <label className="text-sm">
              You Are Here X
              <input className="mt-1 w-full rounded-lg border p-2" value={youAreHereXInput} onChange={(e) => setYouAreHereXInput(e.target.value)} />
            </label>

            <label className="text-sm">
              You Are Here Y
              <input className="mt-1 w-full rounded-lg border p-2" value={youAreHereYInput} onChange={(e) => setYouAreHereYInput(e.target.value)} />
            </label>

            <label className="text-sm">
              Grid Resolution
              <input className="mt-1 w-full rounded-lg border p-2" value={gridResolutionInput} onChange={(e) => setGridResolutionInput(e.target.value)} />
            </label>

            <label className="text-sm">
              Max Travel Distance
              <input className="mt-1 w-full rounded-lg border p-2" value={maxTravelDistanceInput} onChange={(e) => setMaxTravelDistanceInput(e.target.value)} />
            </label>
          </div>

          <div className="grid grid-cols-2 gap-3">
            <button className="rounded-xl bg-amber-500 px-4 py-2 text-white" onClick={autoPlaceYouAreHere}>
              Auto-Place You Are Here
            </button>

            <button className="rounded-xl bg-red-700 px-4 py-2 text-white" onClick={generateSmartEvacuation}>
              Generate Smart Routes
            </button>
          </div>

          <div className="rounded-xl bg-gray-50 p-3 text-sm">
            <div>
              Detected exits: <strong>{detectedExitTargets.length}</strong>
            </div>
            <div className="mt-1 text-gray-600">
              Tip: use labels like <strong>Exit</strong>, <strong>Gate</strong>, or <strong>Beach Access Gate</strong> on room labels or door labels.
            </div>
          </div>

          {routeMessage && (
            <div className="rounded-xl border border-gray-200 bg-white p-3 text-sm">
              {routeMessage}
            </div>
          )}

          <div className="max-h-48 space-y-2 overflow-auto">
            {travelChecks.map((check, index) => (
              <div key={`${check.exitLabel}-${index}`} className="rounded-xl border p-3 text-sm">
                <div className="font-semibold">{check.exitLabel}</div>
                <div>Distance: {formatFeet(check.distance)}</div>
                <div className={check.compliant ? "text-green-700" : "text-red-700"}>
                  {check.compliant ? "Compliant" : "Exceeds travel distance"}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section className="space-y-3 border-t pt-4">
          <h3 className="text-lg font-semibold">11) Blocked Corridors / Hazard Zones</h3>

          <div className="grid grid-cols-2 gap-3">
            <label className="text-sm">
              X
              <input className="mt-1 w-full rounded-lg border p-2" value={blockedZoneXInput} onChange={(e) => setBlockedZoneXInput(e.target.value)} />
            </label>

            <label className="text-sm">
              Y
              <input className="mt-1 w-full rounded-lg border p-2" value={blockedZoneYInput} onChange={(e) => setBlockedZoneYInput(e.target.value)} />
            </label>

            <label className="text-sm">
              Width
              <input className="mt-1 w-full rounded-lg border p-2" value={blockedZoneWidthInput} onChange={(e) => setBlockedZoneWidthInput(e.target.value)} />
            </label>

            <label className="text-sm">
              Height
              <input className="mt-1 w-full rounded-lg border p-2" value={blockedZoneHeightInput} onChange={(e) => setBlockedZoneHeightInput(e.target.value)} />
            </label>

            <label className="col-span-2 text-sm">
              Label
              <input className="mt-1 w-full rounded-lg border p-2" value={blockedZoneLabelInput} onChange={(e) => setBlockedZoneLabelInput(e.target.value)} />
            </label>
          </div>

          <button className="w-full rounded-xl bg-rose-600 px-4 py-2 text-white" onClick={addBlockedZone}>
            Add Blocked Zone
          </button>

          <div className="max-h-40 space-y-2 overflow-auto">
            {blockedZones.map((zone) => (
              <div key={zone.id} className="rounded-xl border p-3 text-sm">
                <div className="font-semibold">{zone.label || `Blocked Zone ${zone.id}`}</div>
                <div>Position: {formatFeet(zone.x)}, {formatFeet(zone.y)}</div>
                <div>Size: {formatFeet(zone.width)} × {formatFeet(zone.height)}</div>
                <button className="mt-2 rounded-lg bg-red-600 px-3 py-1 text-white" onClick={() => deleteBlockedZone(zone.id)}>
                  Delete
                </button>
              </div>
            ))}
          </div>
        </section>

        <section className="space-y-3 border-t pt-4">
          <h3 className="text-lg font-semibold">12) Occupant Load & Basic Compliance</h3>

          <div className="grid grid-cols-2 gap-3">
            <label className="text-sm">
              Occupiable Area
              <input className="mt-1 w-full rounded-lg border p-2" value={occupiableAreaInput} onChange={(e) => setOccupiableAreaInput(e.target.value)} />
            </label>

            <label className="text-sm">
              Load Factor
              <input className="mt-1 w-full rounded-lg border p-2" value={occupantLoadFactorInput} onChange={(e) => setOccupantLoadFactorInput(e.target.value)} />
            </label>

            <label className="col-span-2 text-sm">
              Occupancy Classification
              <input className="mt-1 w-full rounded-lg border p-2" value={occupancyClassification} onChange={(e) => setOccupancyClassification(e.target.value)} />
            </label>
          </div>

          <div className="rounded-xl bg-gray-50 p-3 text-sm space-y-1">
            <div>
              Occupancy Type: <strong>{occupancyClassification}</strong>
            </div>
            <div>
              Calculated Occupant Load: <strong>{occupantLoad}</strong>
            </div>
            <div>
              Minimum Exits Needed: <strong>{exitCountCheck.minimumExits}</strong>
            </div>
            <div className={exitCountCheck.compliant ? "text-green-700" : "text-red-700"}>
              Exits Provided: <strong>{exitCountCheck.provided}</strong> — {exitCountCheck.compliant ? "Compliant" : "Insufficient exits"}
            </div>
          </div>
        </section>

        <div className="border-t pt-4">
          <button className="w-full rounded-xl bg-black px-4 py-3 text-white" onClick={downloadSvg}>
            Download SVG
          </button>
        </div>
      </div>

      <div className="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
        <h2 className="mb-4 text-xl font-bold">Live Preview</h2>

        <div className="overflow-auto rounded-xl border bg-gray-50 p-3">
          <svg
            ref={svgRef}
            viewBox={`0 0 ${planWidth} ${planHeight}`}
            className="min-h-[820px] w-full h-auto"
            preserveAspectRatio="xMidYMid meet"
          >
            <defs>
              <marker
                id="exit-arrow"
                markerWidth="6"
                markerHeight="6"
                refX="5"
                refY="3"
                orient="auto"
                markerUnits="strokeWidth"
                viewBox="0 0 6 6"
              >
                <path d="M 0 0 L 6 3 L 0 6 z" fill="#16a34a" />
              </marker>
            </defs>

            <rect x={0} y={0} width={planWidth} height={planHeight} fill="#f8fafc" />
            {gridLines}
            <rect x={0} y={0} width={planWidth} height={planHeight} fill="none" stroke="#94a3b8" strokeWidth={0.08} />

            {renderBlockedZones()}

            {walls.map((wall) => (
              <g key={`wall-${wall.id}`}>
                <polygon points={pointsToSvgString(wallPolygonPoints(wall))} fill="#1f2937" />
                {renderWallLabel(wall)}
              </g>
            ))}

            {windows.map((item) => renderWindow(item))}
            {doors.map((item) => renderDoorOrOpening(item))}
            {stairs.map((stair) => renderStair(stair))}
            {roomLabels.map((label) => renderRoomLabel(label))}
            {exitPaths.map((path) => renderExitPath(path))}
            {fireExtinguishers.map((item) => renderFireExtinguisher(item))}

            {renderAutoRoutes()}
            {renderAutoSafetySymbols()}
            {renderYouAreHere()}
            {renderLegend()}

            {renderLogo()}
            {renderTitleBlock()}
          </svg>
        </div>
      </div>
    </div>
  );
}
