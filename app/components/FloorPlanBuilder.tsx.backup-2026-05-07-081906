  function renderAutoSafetySymbols() {
    return autoSafetySymbols.map((item) => {
      if (item.type === "exit") {
        return <g key={item.id}>{renderExitIcon(item.x, item.y, item.label)}</g>;
      }
      if (item.type === "pull-station") {
        return <g key={item.id}>{renderPullStation(item.x, item.y, item.label)}</g>;
      }
      if (item.type === "emergency-light") {
        return <g key={item.id}>{renderEmergencyLight(item.x, item.y, item.label)}</g>;
      }
      if (item.type === "aed") {
        return <g key={item.id}>{renderAED(item.x, item.y, item.label)}</g>;
      }
      if (item.type === "first-aid") {
        return <g key={item.id}>{renderFirstAid(item.x, item.y, item.label)}</g>;
      }
      if (item.type === "assembly") {
        return <g key={item.id}>{renderAssemblyPoint(item.x, item.y, item.label)}</g>;
      }
      return null;
    });
  }

  function renderLegend() {
    const baseItems = [
      { key: "exit", label: "Exit" },
      { key: "you", label: "You Are Here" },
      { key: "best", label: "Best Route" },
    ];

    const extraKeys = new Set(autoSafetySymbols.map((s) => s.type));

    const dynamicItems = [];
    if (extraKeys.has("assembly")) dynamicItems.push({ key: "assembly", label: "Assembly Point" });
    if (extraKeys.has("first-aid")) dynamicItems.push({ key: "first-aid", label: "First Aid" });
    if (extraKeys.has("aed")) dynamicItems.push({ key: "aed", label: "AED" });
    if (extraKeys.has("pull-station")) dynamicItems.push({ key: "pull-station", label: "Pull Station" });
    if (extraKeys.has("emergency-light")) dynamicItems.push({ key: "emergency-light", label: "Emergency Light" });
    if (blockedZones.length > 0) dynamicItems.push({ key: "blocked", label: "Blocked / Hazard Zone" });
    if (autoRoutes.length > 1) dynamicItems.push({ key: "alt", label: "Alternate Route" });

    const items = [...baseItems, ...dynamicItems];
    const x = 8;
    const y = 8;
    const rowHeight = 3.1;
    const width = 48;
    const height = 4 + items.length * rowHeight;

    return (
      <g>
        <rect
          x={x}
          y={y}
          width={width}
          height={height}
          fill="#ffffff"
          stroke="#111827"
          strokeWidth={0.12}
          rx={0.35}
        />
        <text x={x + 2} y={y + 2.6} fontSize={0.9} fontWeight="700" fill="#111827">
          Legend
        </text>

        {items.map((item, index) => {
          const rowY = y + 5 + index * rowHeight;

          return (
            <g key={item.key}>
              {item.key === "exit" && (
                <>
                  <rect x={x + 2} y={rowY - 1.05} width={4.2} height={2.1} rx={0.22} fill="#16a34a" />
                  <text x={x + 4.1} y={rowY + 0.35} fontSize={0.55} fill="#ffffff" textAnchor="middle" fontWeight="700">
                    EXIT
                  </text>
                </>
              )}

              {item.key === "you" && (
                <>
                  <circle cx={x + 4.1} cy={rowY} r={1.1} fill="#facc15" stroke="#111827" strokeWidth={0.12} />
                  <circle cx={x + 4.1} cy={rowY} r={0.35} fill="#111827" />
                </>
              )}

              {item.key === "best" && (
                <line x1={x + 2} y1={rowY} x2={x + 6.2} y2={rowY} stroke="#16a34a" strokeWidth={0.45} />
              )}

              {item.key === "alt" && (
                <line x1={x + 2} y1={rowY} x2={x + 6.2} y2={rowY} stroke="#f59e0b" strokeWidth={0.45} strokeDasharray="1 0.5" />
              )}

              {item.key === "assembly" && (
                <circle cx={x + 4.1} cy={rowY} r={1.05} fill="#dbeafe" stroke="#1d4ed8" strokeWidth={0.12} />
              )}

              {item.key === "first-aid" && (
                <>
                  <rect x={x + 3.1} y={rowY - 1} width={2} height={2} rx={0.2} fill="#22c55e" />
                  <rect x={x + 3.95} y={rowY - 0.62} width={0.3} height={1.24} fill="#ffffff" />
                  <rect x={x + 3.48} y={rowY - 0.15} width={1.24} height={0.3} fill="#ffffff" />
                </>
              )}

              {item.key === "aed" && (
                <rect x={x + 3.0} y={rowY - 1} width={2.2} height={2} rx={0.25} fill="#10b981" />
              )}

              {item.key === "pull-station" && (
                <rect x={x + 3.1} y={rowY - 1} width={2} height={2} rx={0.2} fill="#dc2626" />
              )}

              {item.key === "emergency-light" && (
                <rect x={x + 3.0} y={rowY - 0.35} width={2.2} height={0.7} rx={0.1} fill="#0f172a" />
              )}

              {item.key === "blocked" && (
                <rect
                  x={x + 2}
                  y={rowY - 1}
                  width={4.2}
                  height={2}
                  fill="rgba(220, 38, 38, 0.18)"
                  stroke="#dc2626"
                  strokeWidth={0.12}
                  strokeDasharray="0.4 0.2"
                />
              )}

              <text x={x + 8.2} y={rowY + 0.35} fontSize={0.72} fill="#111827">
                {item.label}
              </text>
            </g>
          );
        })}
      </g>
    );
  }

  function getLogoPosition() {
    const size = clamp(parseDimension(logoSizeInput) || 8, 1, 30);
    const pad = Math.max(0, parseDimension(logoPaddingInput) || 1);

    let x = pad;
    let y = pad;

    if (logoPlacement === "top-center") {
      x = (planWidth - size) / 2;
      y = pad;
    } else if (logoPlacement === "top-right") {
      x = planWidth - size - pad;
      y = pad;
    } else if (logoPlacement === "bottom-left") {
      x = pad;
      y = planHeight - size - pad;
    } else if (logoPlacement === "bottom-center") {
      x = (planWidth - size) / 2;
      y = planHeight - size - pad;
    } else if (logoPlacement === "bottom-right") {
      x = planWidth - size - pad;
      y = planHeight - size - pad;
    }

    return { x, y, size };
  }

  function renderLogo() {
    if (!logoDataUrl) return null;
    const pos = getLogoPosition();

    return (
      <image
        href={logoDataUrl}
        x={pos.x}
        y={pos.y}
        width={pos.size}
        height={pos.size}
        preserveAspectRatio="xMidYMid meet"
      />
    );
  }

  function renderTitleBlock() {
    const blockWidth = Math.min(26, Math.max(18, planWidth * 0.3));
    const blockHeight = 11;
    const x = Math.max(0.5, planWidth - blockWidth - 0.75);
    const y = Math.max(0.5, planHeight - blockHeight - 0.75);

    const rows = [
      ["Project", titleBlock.projectTitle],
      ["Building", titleBlock.buildingName],
      ["Floor", titleBlock.floorName],
      ["Drawn By", titleBlock.drawnBy],
      ["Date", titleBlock.date],
      ["Revision", titleBlock.revision],
      ["Occ Load", String(occupantLoad || 0)],
    ] as const;

    const rowHeight = blockHeight / rows.length;

    return (
      <g>
        <rect
          x={x}
          y={y}
          width={blockWidth}
          height={blockHeight}
          fill="#ffffff"
          stroke="#111827"
          strokeWidth={0.12}
        />
        {rows.map(([label, value], index) => {
          const rowY = y + rowHeight * index;
          return (
            <g key={label}>
              {index > 0 && (
                <line
                  x1={x}
                  y1={rowY}
                  x2={x + blockWidth}
                  y2={rowY}
                  stroke="#cbd5e1"
                  strokeWidth={0.04}
                />
              )}
              <line
                x1={x + blockWidth * 0.32}
                y1={rowY}
                x2={x + blockWidth * 0.32}
                y2={rowY + rowHeight}
                stroke="#cbd5e1"
                strokeWidth={0.04}
              />
              <text x={x + 0.45} y={rowY + rowHeight * 0.62} fontSize={0.55} fill="#334155">
                {label}
              </text>
              <text
                x={x + blockWidth * 0.34}
                y={rowY + rowHeight * 0.62}
                fontSize={0.55}
                fill="#0f172a"
                fontWeight="700"
              >
                {value}
              </text>
            </g>
          );
        })}
      </g>
    );
  }

  return (
    <div className="grid grid-cols-1 gap-6 p-4 lg:grid-cols-[440px_1fr]">
      <div className="space-y-6 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm">
        <div>
          <h2 className="text-2xl font-bold">EFP - Full Floor / Evacuation Builder</h2>
          <p className="mt-1 text-sm text-gray-600">
            Draw the plan, place openings and labels, then generate smart evacuation routes and safety graphics.
          </p>
        </div>

        <section className="space-y-3">
          <h3 className="text-lg font-semibold">1) Plan Settings</h3>
          <div className="grid grid-cols-1 gap-3">
            <label className="text-sm">
              Plan Width
              <input className="mt-1 w-full rounded-lg border p-2" value={planWidthInput} onChange={(e) => setPlanWidthInput(e.target.value)} />
            </label>

            <label className="text-sm">
              Plan Height
              <input className="mt-1 w-full rounded-lg border p-2" value={planHeightInput} onChange={(e) => setPlanHeightInput(e.target.value)} />
            </label>

            <label className="text-sm">
              Default Wall Thickness
              <input className="mt-1 w-full rounded-lg border p-2" value={defaultWallThicknessInput} onChange={(e) => setDefaultWallThicknessInput(e.target.value)} />
            </label>
          </div>

          <div className="rounded-xl bg-gray-50 p-3 text-sm">
            Current plan size: <strong>{formatFeet(planWidth)}</strong> × <strong>{formatFeet(planHeight)}</strong>
          </div>

          <div className="grid grid-cols-2 gap-3">
            <button className="rounded-xl bg-black px-4 py-2 text-white" onClick={addExteriorWalls}>
              Add Exterior Walls
            </button>
            <button className="rounded-xl bg-gray-200 px-4 py-2 text-gray-900" onClick={clearAll}>
              Clear All
            </button>
          </div>
        </section>

        <section className="space-y-3 border-t pt-4">
          <h3 className="text-lg font-semibold">2) Walls (Straight or Angled)</h3>
          <div className="grid grid-cols-2 gap-3">
            <label className="text-sm">
              Start X
              <input className="mt-1 w-full rounded-lg border p-2" value={wallStartXInput} onChange={(e) => setWallStartXInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Start Y
              <input className="mt-1 w-full rounded-lg border p-2" value={wallStartYInput} onChange={(e) => setWallStartYInput(e.target.value)} />
            </label>
            <label className="text-sm">
              End X
              <input className="mt-1 w-full rounded-lg border p-2" value={wallEndXInput} onChange={(e) => setWallEndXInput(e.target.value)} />
            </label>
            <label className="text-sm">
              End Y
              <input className="mt-1 w-full rounded-lg border p-2" value={wallEndYInput} onChange={(e) => setWallEndYInput(e.target.value)} />
            </label>
            <label className="text-sm">
              Thickness
              <input className="mt-1 w-full rounded-lg border p-2" value={wallThicknessInput} onChange={(e) => setWallThicknessInput(e.target.value)} />
