  function renderFirstAid(x: number, y: number, label?: string) {
    return (
      <g>
        <rect
          x={x - 1.25}
          y={y - 1.25}
          width={2.5}
          height={2.5}
          rx={0.3}
          fill="#22c55e"
          stroke="#166534"
          strokeWidth={0.12}
        />
        <rect x={x - 0.22} y={y - 0.8} width={0.44} height={1.6} fill="#ffffff" />
        <rect x={x - 0.8} y={y - 0.22} width={1.6} height={0.44} fill="#ffffff" />
        {label && (
          <text x={x} y={y + 2.0} fontSize={0.45} textAnchor="middle" fill="#166534">
            {label}
          </text>
        )}
      </g>
    );
