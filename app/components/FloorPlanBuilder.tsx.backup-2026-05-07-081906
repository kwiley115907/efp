  function renderBlockedZones() {
    return blockedZones.map((zone) => (
      <g key={`blocked-zone-${zone.id}`}>
        <rect
          x={zone.x}
          y={zone.y}
          width={zone.width}
          height={zone.height}
          fill="rgba(220, 38, 38, 0.18)"
          stroke="#dc2626"
          strokeWidth={0.18}
          strokeDasharray="0.8 0.4"
        />
        {zone.label && (
          <text
            x={zone.x + zone.width / 2}
            y={zone.y + zone.height / 2}
            fontSize={0.75}
            textAnchor="middle"
            dominantBaseline="middle"
            fill="#7f1d1d"
            fontWeight="700"
          >
            {zone.label}
          </text>
        )}
      </g>
    ));
  }

  function renderAutoRoutes() {
    const colors = ["#16a34a", "#f59e0b", "#8b5cf6"];

    return autoRoutes.map((route, index) => (
      <g key={`auto-route-${index}`}>
        <polyline
          points={route.path.map((p) => `${p.x},${p.y}`).join(" ")}
          fill="none"
          stroke={colors[index] || "#16a34a"}
          strokeWidth={0.55}
          strokeDasharray={index === 0 ? "none" : "1.1 0.6"}
          markerEnd="url(#exit-arrow)"
        />
        <text
          x={route.path[route.path.length - 1]?.x ?? 0}
          y={(route.path[route.path.length - 1]?.y ?? 0) - 1.6}
          fontSize={0.75}
          textAnchor="middle"
          fill={colors[index] || "#16a34a"}
          fontWeight="700"
        >
          {index === 0 ? "BEST ROUTE" : `ALT ${index}`}
        </text>
      </g>
    ));
  }

  function renderYouAreHere() {
    return (
      <g>
        <circle
          cx={youAreHerePoint.x}
          cy={youAreHerePoint.y}
          r={1.6}
          fill="#facc15"
          stroke="#111827"
          strokeWidth={0.18}
        />
        <circle cx={youAreHerePoint.x} cy={youAreHerePoint.y} r={0.55} fill="#111827" />
        <text
          x={youAreHerePoint.x}
          y={youAreHerePoint.y - 2.4}
          fontSize={0.95}
          fontWeight="700"
          textAnchor="middle"
          fill="#111827"
        >
          YOU ARE HERE
        </text>
      </g>
    );
  }

  function renderExitIcon(x: number, y: number, label?: string) {
    return (
      <g>
        <rect
          x={x - 2.2}
          y={y - 1.1}
          width={4.4}
          height={2.2}
          rx={0.25}
          fill="#16a34a"
          stroke="#14532d"
          strokeWidth={0.1}
        />
        <text
          x={x}
          y={y + 0.3}
          fontSize={0.7}
          fill="#ffffff"
          fontWeight="700"
          textAnchor="middle"
        >
          EXIT
        </text>
        {label && (
          <text
            x={x}
            y={y - 1.8}
            fontSize={0.55}
            textAnchor="middle"
            fill="#166534"
            fontWeight="700"
          >
            {label}
          </text>
        )}
      </g>
    );
  }

  function renderPullStation(x: number, y: number, label?: string) {
    return (
      <g>
        <rect
          x={x - 1.1}
          y={y - 1.1}
          width={2.2}
          height={2.2}
          rx={0.2}
          fill="#dc2626"
          stroke="#7f1d1d"
          strokeWidth={0.12}
        />
        <text x={x} y={y + 0.35} fontSize={0.72} textAnchor="middle" fill="#ffffff" fontWeight="700">
          P
        </text>
        {label && (
          <text x={x} y={y + 2.2} fontSize={0.48} textAnchor="middle" fill="#7f1d1d">
            {label}
          </text>
        )}
      </g>
    );
  }

  function renderEmergencyLight(x: number, y: number, label?: string) {
    return (
      <g>
        <rect
          x={x - 1.2}
          y={y - 0.45}
          width={2.4}
          height={0.9}
          rx={0.15}
          fill="#0f172a"
        />
        <circle cx={x - 0.65} cy={y + 0.95} r={0.28} fill="#f8fafc" stroke="#334155" strokeWidth={0.06} />
        <circle cx={x + 0.65} cy={y + 0.95} r={0.28} fill="#f8fafc" stroke="#334155" strokeWidth={0.06} />
        {label && (
          <text x={x} y={y - 1.1} fontSize={0.45} textAnchor="middle" fill="#0f172a">
            {label}
          </text>
        )}
      </g>
    );
  }

  function renderAED(x: number, y: number, label?: string) {
    return (
      <g>
        <rect
          x={x - 1.35}
          y={y - 1.1}
          width={2.7}
          height={2.2}
          rx={0.3}
          fill="#10b981"
          stroke="#065f46"
          strokeWidth={0.12}
        />
        <path
          d={`M ${x - 0.5} ${y} C ${x - 0.75} ${y - 0.5}, ${x - 1.05} ${y - 0.25}, ${x - 1.05} ${y + 0.15}
              C ${x - 1.05} ${y + 0.7}, ${x - 0.45} ${y + 0.95}, ${x} ${y + 1.15}
              C ${x + 0.45} ${y + 0.95}, ${x + 1.05} ${y + 0.7}, ${x + 1.05} ${y + 0.15}
              C ${x + 1.05} ${y - 0.25}, ${x + 0.75} ${y - 0.5}, ${x + 0.5} ${y}
              C ${x + 0.2} ${y - 0.5}, ${x - 0.2} ${y - 0.5}, ${x - 0.5} ${y} Z`}
          fill="#ffffff"
        />
        {label && (
          <text x={x} y={y + 2.0} fontSize={0.45} textAnchor="middle" fill="#065f46">
            {label}
          </text>
