            {walls.length === 0 ? (
              <p className="text-sm text-gray-500">No walls yet.</p>
            ) : (
              walls.map((wall) => (
                <div key={wall.id} className="rounded-xl border p-3 text-sm">
                  <div className="font-semibold">{wall.label || `Wall ${wall.id}`}</div>
                  <div>Start: {formatFeet(wall.start.x)}, {formatFeet(wall.start.y)}</div>
                  <div>End: {formatFeet(wall.end.x)}, {formatFeet(wall.end.y)}</div>
