  function renderAssemblyPoint(x: number, y: number, label?: string) {
    return (
      <g>
        <circle
          cx={x}
          cy={y}
          r={1.25}
          fill="#dbeafe"
          stroke="#1d4ed8"
          strokeWidth={0.12}
        />
        <path d={`M ${x} ${y - 0.7} L ${x} ${y + 0.15}`} stroke="#1d4ed8" strokeWidth={0.15} />
        <path d={`M ${x - 0.35} ${y - 0.2} L ${x} ${y + 0.15} L ${x + 0.35} ${y - 0.2}`} fill="none" stroke="#1d4ed8" strokeWidth={0.15} />
        {label && (
          <text x={x} y={y + 2.0} fontSize={0.45} textAnchor="middle" fill="#1d4ed8">
            {label}
          </text>
        )}
